# Copy to .env and fill values. Never commit .env.
# Add variables here as the project grows.

# Vercel Postgres (Neon) database — ADR 003
POSTGRES_URL=
DATABASE_URL=

# OpenRouter LLM gateway (server-side summarization) — ADR 004
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Vercel Cron (scheduled research) — FR-12. Vercel sends this as
# `Authorization: Bearer <CRON_SECRET>` to GET /api/cron; the handler verifies it.
CRON_SECRET=

# Atlassian integrations (Jira + Confluence, same Cloud site) — ADR 008
# API token: id.atlassian.com → Security → API tokens. Basic auth = email:token.
ATLASSIAN_BASE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_PROJECT_KEY=KAN
CONFLUENCE_SPACE_KEY=SOFTWAREEN
